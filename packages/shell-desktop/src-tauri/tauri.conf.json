{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jinn",
  "version": "0.1.0",
  "identifier": "run.jinn.shell.desktop",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "icon": ["icons/icon.png", "icons/icon.icns"]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["jinn"]
      }
    }
  }
}
